{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genecoder.dev/schema/metrics.kpi.schema.json",
  "title": "GeneCoder run-scoped metrics.kpi.json artifact",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "generated_at",
    "kpis",
    "artifacts"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "artifacts": {
      "type": "object",
      "required": [
        "run_schema"
      ],
      "additionalProperties": false,
      "properties": {
        "run_schema": {
          "type": "string",
          "pattern": "(^|.*/)?metrics\\.json$",
          "not": {
            "pattern": "(^~($|/))|(/\\.genecoder/)"
          }
        }
      }
    },
    "kpis": {
      "type": "object",
      "required": [
        "comparison",
        "dashboard"
      ],
      "additionalProperties": false,
      "properties": {
        "comparison": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "boolean",
              "null"
            ]
          }
        },
        "dashboard": {
          "type": "object"
        }
      }
    }
  }
}
